{
  "name": "seedfall",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "vendor-forge": "node scripts/vendor-forge.mjs",
    "get-pocketbase": "node scripts/get-pocketbase.mjs",
    "pb": "node scripts/get-pocketbase.mjs && .pocketbase/pocketbase serve --http 127.0.0.1:8090 --dir .pocketbase/pb_data --migrationsDir pb_migrations",
    "trainer": "node server/trainer.mjs",
    "app": "node scripts/run-app.mjs",
    "start": "node scripts/run-app.mjs",
    "pixelgen:user": "node scripts/pixelgen-user.mjs",
    "pixelgen:admin": "node scripts/pixelgen-admin.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "idb-keyval": "^6.3.0",
    "pixi.js": "^8.22.0",
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
